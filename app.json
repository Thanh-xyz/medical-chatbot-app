{
  "expo": {
    "name": "Healthcare",
    "slug": "MyApp",
    "scheme": "healthcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-healthcare.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-healthcare.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ntrthanh.healthcare",
      "associatedDomains": [
        "applinks:healthcare-system.ntrthanh.io.vn"
      ],
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ứng dụng cần quyền micro để ghi âm câu hỏi y tế của bạn.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ntrthanh.healthcare",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-healthcare.jpg",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a5e64a11-2588-42a1-8658-78312e82bb5c"
      }
    }
  }
}